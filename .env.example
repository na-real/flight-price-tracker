# ============================================================
# SKYTRACKER ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Mandatory Security Key in Production (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_64_character_cryptographically_secure_random_hex_key

# External Flight Search API
SERPAPI_KEY=your_serpapi_key_here

# Mandatory Production Database: Managed PostgreSQL Connection URL
# SQLite (DB_PATH) is strictly for local development and testing. Production deployments
# (such as Render) use ephemeral container filesystems where SQLite files are wiped upon restart.
# In production, a persistent PostgreSQL instance (e.g. Supabase or Render PostgreSQL) is required.
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name
DB_PATH=flights.db  # Local development fallback only

# CORS Allowed Origins (Comma-separated, optional)
# ALLOWED_ORIGINS=https://skytrack-flights.onrender.com

# SMTP Notification Settings for Price Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ============================================================
# API QUOTA GUARDIAN & RELIABILITY CONFIGURATION
# ============================================================
# Administrative token for /api/diagnostics/quota
ADMIN_DIAGNOSTICS_TOKEN=your_secure_diagnostics_token_here

# SerpAPI Quota & Budgets (Set according to your actual account plan)
SERPAPI_MONTHLY_BUDGET=100              # Total account monthly searches limit
SERPAPI_DAILY_BUDGET=25                 # Max live searches per day across all workers
SERPAPI_MINUTE_BUDGET=10                # Max live searches per minute burst limit
SERPAPI_RESERVED_SEARCH_QUOTA=15        # Reserve for real-time user searches (background checks yield)
SERPAPI_SAFETY_MARGIN=5                 # Safety threshold below absolute plan ceiling
SERPAPI_TIMEOUT_SECONDS=25              # Upstream HTTP request timeout

# Amadeus Self-Service API (Optional fallback/metasearch provider)
# AMADEUS_CLIENT_ID=your_amadeus_client_id
# AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_MONTHLY_BUDGET=1000
AMADEUS_DAILY_BUDGET=100
AMADEUS_MINUTE_BUDGET=10
AMADEUS_RESERVED_SEARCH_QUOTA=50
AMADEUS_SAFETY_MARGIN=10
AMADEUS_TIMEOUT_SECONDS=15

# Background Price Checker Cron Budgeting
BACKGROUND_CHECK_MAX_CALLS_PER_RUN=10   # Max API queries executed per scheduled cron run
BACKGROUND_CHECK_REUSE_WINDOW_SECONDS=7200  # Reuse observations within 2 hours

# Quota-Aware Cache TTLs (Seconds)
API_CACHE_TTL_SEARCH=900                # 15 minutes for interactive flight search results
API_CACHE_TTL_CHECKER=3600              # 1 hour for background price tracking queries
API_CACHE_TTL_REFERENCE=1800            # 30 minutes for reference one-way calculations

# Circuit Breaker & Retry Controls
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3     # Consecutive failures before opening circuit
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60     # Cooldown period for transient errors (5xx/timeouts)
CIRCUIT_BREAKER_RATE_LIMIT_COOLDOWN=3600 # Cooldown period for 429 quota exhaustion (1 hour)
CIRCUIT_BREAKER_AUTH_COOLDOWN=86400     # Cooldown period for invalid credentials (24 hours)
API_MAX_RETRIES=2                       # Bounded retries for transient 5xx/network errors
